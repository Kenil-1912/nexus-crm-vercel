# Copy to server/.env for local development. On Vercel, set the same names in
# Project Settings -> Environment Variables (no .env file is used there).

# Database. Locally: your own PostgreSQL.
# Supabase: Project Settings -> Database -> Connection string.
#   - On Vercel use the "Transaction pooler" string (port 6543).
#   - For npm run db:reset from your computer, the "Session pooler" string (port 5432) is safest.
# Set DATABASE_SSL=true for Supabase.
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus_crm
DATABASE_SSL=false
# Connections per running instance. Use 2 on Vercel.
PG_POOL_MAX=10

PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# The address of the front end; used for links in emails and for CORS.
# Locally http://localhost:5173, on Vercel https://your-project.vercel.app
APP_URL=http://localhost:5173

# File storage. Leave SUPABASE_URL empty to keep files in the local database.
# Supabase: Project Settings -> API. Keep the service role key secret: it is
# only ever used by the API, never sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=documents

# Secret that Vercel Cron sends to /api/cron/daily-jobs. Any long random string.
CRON_SECRET=

# Email. Leave SMTP_HOST empty to record emails in the staff Email log instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RIC Admissions <admissions@example.com>"
